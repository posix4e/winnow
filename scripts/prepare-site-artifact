#!/usr/bin/env python3
"""Normalize and validate wallet journey evidence independently of the website."""
import argparse
from datetime import datetime, timezone
import hashlib
import json
import math
import os
from pathlib import Path
import re
import shutil
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parent.parent
TEST = "test01CreateReceiveSendConfirm"
VIDEO = "videos/wallet-journey.mp4"
MANIFEST = "journey-provenance.json"
MAX_BYTES = 25 * 1024 * 1024


def digest(path):
    with path.open("rb") as source:
        return hashlib.file_digest(source, "sha256").hexdigest()


def captures(root):
    names = []
    for path in sorted((root / "UITests").glob("*.swift")):
        names.extend(re.findall(r'Screenshots\.capture\(app, "([a-z0-9-]+)", testCase: self\)', path.read_text()))
    if len(names) != 11 or len(set(names)) != 11:
        raise ValueError("expected the focused journey's 11 unique checkpoint captures")
    return sorted(name + ".png" for name in names)


def probe(path):
    result = subprocess.run([
        "ffprobe", "-v", "error", "-select_streams", "v:0", "-show_entries",
        "format=duration:stream=width,height", "-of", "json", str(path)],
        check=True, text=True, capture_output=True)
    data = json.loads(result.stdout)
    duration = float(data["format"]["duration"])
    if not math.isfinite(duration) or duration <= 0:
        raise ValueError("recording has no finite positive duration")
    return {"duration_seconds": duration, "width": data["streams"][0]["width"],
            "height": data["streams"][0]["height"], "bytes": path.stat().st_size,
            "sha256": digest(path)}


def normalize_video(source, destination):
    original = probe(source)
    # Leave 1 MiB for muxing overhead. The size check below is authoritative.
    bitrate = int(24 * 1024 * 1024 * 8 / original["duration_seconds"])
    if bitrate < 150_000:
        raise ValueError("recording is too long for a readable video under the Pages file limit")
    # simctl can repeat the preceding VFR sample's long duration on its last
    # frame. fps would then invent a frozen tail beyond the MP4's actual end.
    # Keep the entire container timeline, including its final displayed frame.
    subprocess.run([
        "ffmpeg", "-hide_banner", "-loglevel", "error", "-nostdin", "-y",
        "-fflags", "+igndts", "-i", str(source), "-map", "0:v:0", "-an",
        "-t", str(original["duration_seconds"]),
        "-vf", "scale=w='min(720,iw)':h=-2,fps=24", "-c:v", "libx264",
        "-preset", "medium", "-b:v", str(bitrate), "-maxrate", str(bitrate),
        "-bufsize", str(bitrate * 2), "-pix_fmt", "yuv420p",
        "-map_metadata", "-1", "-movflags", "+faststart", str(destination)], check=True)
    video = probe(destination)
    if video["bytes"] > MAX_BYTES:
        raise ValueError("normalized recording exceeds the 25 MiB Pages file limit")
    if abs(video["duration_seconds"] - original["duration_seconds"]) > 0.5:
        raise ValueError("normalization changed the recording duration by more than half a second: "
                         f"{original['duration_seconds']}s to {video['duration_seconds']}s")
    return original, video


def run_identity(source_sha, run_url, root):
    source_sha = source_sha or subprocess.check_output(
        ["git", "-C", str(root), "rev-parse", "HEAD"], text=True).strip()
    if not re.fullmatch(r"[0-9a-f]{40}", source_sha):
        raise ValueError("source SHA must identify the tested commit")
    if not run_url and os.environ.get("GITHUB_RUN_ID"):
        run_url = (f'{os.environ.get("GITHUB_SERVER_URL", "https://github.com")}/'
                   f'{os.environ["GITHUB_REPOSITORY"]}/actions/runs/{os.environ["GITHUB_RUN_ID"]}')
    if not run_url or not re.fullmatch(r"https://[^\s]+/actions/runs/[0-9]+", run_url):
        raise ValueError("fresh media needs its CI run URL (or --run-url)")
    return source_sha, run_url


def fresh_media(journey, media, names, source_sha, run_url):
    log = (journey / "node-ui.log").read_text()
    passed = re.search(r"Test Case '-\[WinnowAppUITests\.WinnowAppUITests " + TEST
                       + r"\]' passed \(([0-9.]+) seconds\)\.", log)
    if not passed or "** TEST EXECUTE SUCCEEDED **" not in log:
        raise ValueError("journey log does not establish a successful focused test")
    if not (journey / "NodeUI.xcresult").is_dir():
        raise ValueError("missing journey result bundle")
    screenshots = journey / "node-screenshots"
    if not screenshots.is_dir():
        screenshots = journey / "screenshots"
    for name in names:
        source = screenshots / name
        if not source.is_file() or not source.read_bytes().startswith(b"\x89PNG\r\n\x1a\n"):
            raise ValueError(f"missing or invalid checkpoint: {name}")
    (media / "videos").mkdir(parents=True)
    (media / "screenshots").mkdir()
    original, video = normalize_video(journey / "journey.mp4", media / VIDEO)
    for name in names:
        shutil.copyfile(screenshots / name, media / "screenshots" / name)
    evidence = {"version": 1, "source_sha": source_sha, "run_url": run_url,
                "test": TEST, "result": "passed", "test_seconds": float(passed[1]),
                "normalized_at": datetime.now(timezone.utc).isoformat(),
                "original_video": original, "video": video,
                "screenshots": {name: digest(media / "screenshots" / name) for name in names}}
    (media / MANIFEST).write_text(json.dumps(evidence, indent=2) + "\n")


def validate_media(media, names):
    evidence = json.loads((media / MANIFEST).read_text())
    if (not isinstance(evidence, dict) or type(evidence.get("version")) is not int
            or evidence.get("version") != 1 or evidence.get("test") != TEST
            or evidence.get("result") != "passed" or not isinstance(evidence.get("screenshots"), dict)
            or sorted(evidence["screenshots"]) != names):
        raise ValueError("cached media does not describe this focused journey")
    # Cached provenance must be complete; never replace missing identity with
    # the current checkout or run while validating an older recording.
    if any(not isinstance(evidence.get(key), str) or not evidence[key]
           for key in ["source_sha", "run_url"]):
        raise ValueError("cached media is missing its original source or run URL")
    run_identity(evidence["source_sha"], evidence["run_url"], ROOT)
    video = evidence.get("video")
    if not isinstance(video, dict):
        raise ValueError("cached media has no video metadata")
    # These fields accompany the retained wallet recording. Reject bad
    # types, bools, NaN and infinity before choosing the cached build path.
    for label, value in [("test_seconds", evidence.get("test_seconds")),
                         ("video.duration_seconds", video.get("duration_seconds"))]:
        try:
            valid = type(value) in (int, float) and value > 0 and math.isfinite(value)
        except OverflowError:
            valid = False
        if not valid:
            raise ValueError(f"invalid cached media field: {label}")
    for key in ["width", "height", "bytes"]:
        if type(video.get(key)) is not int or video[key] <= 0:
            raise ValueError(f"invalid cached media field: video.{key}")
    files = {VIDEO: video.get("sha256"),
             **{f"screenshots/{name}": value for name, value in evidence["screenshots"].items()}}
    for name, expected in files.items():
        if not isinstance(expected, str) or not re.fullmatch(r"[0-9a-f]{64}", expected):
            raise ValueError(f"invalid cached media checksum: {name}")
        path = media / name
        if not path.is_file() or path.stat().st_size > MAX_BYTES or digest(path) != expected:
            raise ValueError(f"media checksum or size mismatch: {name}")
    if video["bytes"] != (media / VIDEO).stat().st_size:
        raise ValueError("cached video byte count does not match the media")
    return evidence


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    choice = parser.add_mutually_exclusive_group(required=True)
    choice.add_argument("--normalize-journey", type=Path, help="normalize verified journey media without building a website")
    choice.add_argument("--validate-media", type=Path, help="only validate cached media; do not build or copy")
    parser.add_argument("--media-output", type=Path, help="write normalized journey evidence")
    parser.add_argument("--source-sha", help="tested source when replaying a retained journey; defaults to HEAD")
    parser.add_argument("--run-url", help="evidence run when replaying a retained journey; defaults to current CI run")
    args = parser.parse_args(argv)
    if args.validate_media is not None:
        if any(value is not None for value in [args.media_output, args.source_sha, args.run_url]):
            parser.error("--validate-media cannot be combined with normalization options")
    elif args.media_output is None:
        parser.error("--normalize-journey requires --media-output")
    try:
        if args.normalize_journey is not None:
            names = captures(ROOT)
            source_sha, run_url = run_identity(args.source_sha, args.run_url, ROOT)
            fresh_media(args.normalize_journey, args.media_output, names, source_sha, run_url)
            validate_media(args.media_output, names)
            print(f"Normalized verified journey media: {args.media_output}")
            return
        if args.validate_media is not None:
            validate_media(args.validate_media, captures(ROOT))
            print(f"Validated cached journey media: {args.validate_media}")
            return
    except (ValueError, OSError, KeyError, subprocess.CalledProcessError) as error:
        raise SystemExit(str(error)) from error


if __name__ == "__main__":
    main()
