#!/bin/bash
# Return one available iPhone (default) or iPad on the newest iOS runtime, or on
# the iOS version named by IOS_SIMULATOR_RUNTIME (for example 26.5) when it is set.
set -euo pipefail
xcrun simctl list devices available -j | python3 -c '
import json, os, sys
family = sys.argv[1]
if family not in ("iPhone", "iPad"): sys.exit("expected iPhone or iPad")
wanted = os.environ.get("IOS_SIMULATOR_RUNTIME")
runtimes = json.load(sys.stdin)["devices"]
for runtime in sorted(runtimes, reverse=True):
    if ".iOS-" not in runtime:
        continue
    if wanted and not runtime.endswith(".iOS-" + wanted.replace(".", "-")):
        continue
    for device in runtimes[runtime]:
        if device["isAvailable"] and device["name"].startswith(family):
            print(device["udid"])
            sys.exit(0)
sys.exit("no available " + family + " simulator" + (" on iOS " + wanted if wanted else ""))' "${1:-iPhone}"
