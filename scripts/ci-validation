#!/usr/bin/env python3
"""Complete CI evidence. A cache miss always means fresh validation."""
import argparse
from datetime import datetime, timezone, timedelta
import hashlib
import json
import os
from pathlib import Path
import runpy
import re
import subprocess
import sys

ROOT = Path(__file__).resolve().parent.parent
CACHE = runpy.run_path(str(ROOT / 'scripts/ci-journey-cache'))
LANES = {'package', 'build', 'units', 'journey'}
# The runner image is recorded in each lane but not pinned: WarpBuild updates
# it regularly, and the Xcode build, iOS runtime and architecture are what the
# evidence depends on.
POLICY = {'schema': 2, 'xcode': '17F113', 'runtime': 'iOS 26.5', 'architecture': 'arm64', 'max_age_days': 7,
          'minimum_tests': {'package': 646, 'units': 265, 'journey': 1}}


def sha(path):
    with Path(path).open('rb') as f:
        return hashlib.file_digest(f, 'sha256').hexdigest()


def fingerprint(ref='HEAD', cwd=None):
    # Complete validation also covers the website workflow and media validators,
    # which the older recording-only cache intentionally excludes.
    original = CACHE['fingerprint'](ref, cwd)
    tree = subprocess.check_output(['git', 'ls-tree', '-r', '-z', '--full-tree', ref], cwd=cwd)
    validation_inputs = [entry for entry in tree.split(b'\0') if entry and
                         entry.split(b'\t', 1)[1].startswith((b'.github/workflows/', b'scripts/'))]
    return hashlib.sha256(original.encode() + b'\0'.join(sorted(validation_inputs))).hexdigest()


def identity():
    return {'fingerprint': fingerprint(), 'policy': POLICY,
            'workflow_revision': subprocess.check_output(
                ['git', 'rev-parse', 'HEAD:.github/workflows/ci-parallel.yml'], text=True).strip()}


def validate(record, expected, repository, now=None):
    now = now or datetime.now(timezone.utc)
    try:
        made = datetime.fromisoformat(record['created_at'])
        return (record['identity'] == expected and record['repository'] == repository
                and record['result'] == 'success' and record['fresh'] is True
                and set(record['lanes']) == LANES
                and all(v['result'] == 'success' and v['tests'] >= 0
                        and v['architecture'] == POLICY['architecture']
                        and isinstance(v['image'], str) and v['image']
                        and v['runtime'].startswith(POLICY['runtime'] + ' (')
                        and v['source_sha'] == record['source_sha'] for v in record['lanes'].values())
                and record['lanes']['build']['release_inspected'] is True
                and re.fullmatch(r'[0-9a-f]{64}', record['lanes']['build']['debug_sha256']) is not None
                and all(record['lanes'][lane]['debug_sha256'] == record['lanes']['build']['debug_sha256']
                        for lane in ('units', 'journey'))
                and all(record['lanes'][x]['tests'] >= count for x, count in POLICY['minimum_tests'].items())
                and timedelta(0) <= now - made <= timedelta(days=7)
                and re.fullmatch(r'[0-9a-f]{40}', record['source_sha']) is not None
                and isinstance(record['files'], dict)
                and {'lanes/' + lane + '.json' for lane in LANES} <= set(record['files'])
                and 'media/journey-provenance.json' in record['files'])
    except (KeyError, ValueError, TypeError):
        return False


def verify_files(directory, record):
    root = Path(directory).resolve()
    for name, digest in record['files'].items():
        p = root / name
        if (Path(name).is_absolute() or '..' in Path(name).parts
                or any(part.is_symlink() for part in [p, *p.parents] if part != root)
                or not p.resolve().is_relative_to(root) or not p.is_file() or sha(p) != digest):
            raise ValueError('invalid evidence file: ' + name)


def api(path):
    return json.loads(subprocess.check_output(['gh', 'api', path], timeout=30))


def lookup(destination):
    expected = identity()
    repo = os.environ['GITHUB_REPOSITORY']
    digest = expected['fingerprint']
    now = datetime.now(timezone.utc)
    artifacts = api(f'repos/{repo}/actions/artifacts?name=validation-{digest}&per_page=100')['artifacts']
    for artifact in artifacts:
        if artifact['name'] != f'validation-{digest}' or artifact['expired'] or artifact['size_in_bytes'] <= 0:
            continue
        run = api(f"repos/{repo}/actions/runs/{artifact['workflow_run']['id']}")
        if (run['conclusion'] != 'success' or run['status'] != 'completed'
                or run['repository']['full_name'] != repo or run['head_repository']['full_name'] != repo
                or run['head_sha'] != artifact['workflow_run']['head_sha']
                or run['path'].split('@')[0] != '.github/workflows/ci.yml'
                or run['event'] not in {'pull_request', 'push', 'workflow_dispatch', 'schedule'}
                or now - datetime.fromisoformat(run['created_at'].replace('Z', '+00:00')) > timedelta(days=7)):
            continue
        subprocess.run(['gh', 'run', 'download', str(run['id']), '-R', repo, '-n', artifact['name'], '-D', str(destination)], check=True)
        record = json.loads((destination / 'validation.json').read_text())
        if record['run_id'] != str(run['id']) or record['source_sha'] != run['head_sha'] or str(record['attempt']) != str(run['run_attempt']):
            raise ValueError('source run identity mismatch')
        if not validate(record, expected, repo):
            raise ValueError('validation identity mismatch')
        verify_files(destination, record)
        subprocess.run([str(ROOT / 'scripts/prepare-site-artifact'), '--validate-media', str(destination / 'media')], check=True)
        return True
    return False


def outputs(values):
    text = ''.join(f'{k}={v}\n' for k, v in values.items())
    print(text, end='')
    if p := os.environ.get('GITHUB_OUTPUT'):
        with open(p, 'a') as f: f.write(text)


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('command', choices=['lookup', 'publish', 'verify'])
    parser.add_argument('directory', type=Path)
    args = parser.parse_args()
    root = args.directory
    if args.command == 'lookup':
        reuse = False
        if os.environ.get('FORCE_FRESH') != 'true' and os.environ.get('GITHUB_EVENT_NAME') not in {'schedule', 'workflow_dispatch'}:
            try: reuse = lookup(root)
            except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as error:
                print(f'Evidence unavailable; running fresh validation ({type(error).__name__}).', file=sys.stderr)
        outputs({'reuse': str(reuse).lower(), 'fingerprint': identity()['fingerprint']})
    elif args.command == 'publish':
        lanes = {p.stem: json.loads(p.read_text()) for p in (root / 'lanes').glob('*.json')}
        record = {'identity': identity(), 'repository': os.environ['GITHUB_REPOSITORY'],
                  'source_sha': subprocess.check_output(['git', 'rev-parse', 'HEAD'], text=True).strip(),
                  'run_id': os.environ['GITHUB_RUN_ID'], 'attempt': os.environ['GITHUB_RUN_ATTEMPT'],
                  'created_at': datetime.now(timezone.utc).isoformat(), 'fresh': True,
                  'result': 'success', 'lanes': lanes,
                  'files': {str(p.relative_to(root)): sha(p) for p in sorted(root.rglob('*')) if p.is_file() and p.name != 'validation.json'}}
        if not validate(record, identity(), os.environ['GITHUB_REPOSITORY']):
            raise SystemExit('Incomplete validation cannot become reusable evidence')
        (root / 'validation.json').write_text(json.dumps(record, indent=2) + '\n')
    else:
        record = json.loads((root / 'validation.json').read_text())
        if not validate(record, identity(), os.environ['GITHUB_REPOSITORY']):
            raise SystemExit('Invalid validation record')
        verify_files(root, record)

if __name__ == '__main__': main()
