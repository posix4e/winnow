#!/bin/bash
# Live gateway journey on a paired iPhone or a simulator, whose network must be
# on the tailnet that runs both gateways (docs/peer-gateways.md): Automatic
# discovery, I2P-only with an I2P Bitcoin peer, and Tor-only with an onion
# peer. A disposable mainnet wallet; nothing is sent.
set -euo pipefail
cd "$(dirname "$0")/.."
destination="${1:?usage: check-live-gateways-ui <Xcode destination> <new evidence directory>}"
evidence="${2:?a new evidence directory is required}"
mkdir "$evidence"
evidence="$(cd "$evidence" && pwd)"
export TEST_RUNNER_WINNOW_LIVE_GATEWAYS_UI=1
xcodebuild -project WinnowApp.xcodeproj -scheme WinnowApp \
  -destination "$destination" -derivedDataPath "$evidence/DerivedData" \
  -resultBundlePath "$evidence/LiveGateways.xcresult" \
  -only-testing:WinnowAppUITests/LiveGatewayDeviceTests \
  -parallel-testing-enabled NO -allowProvisioningUpdates \
  -skipPackagePluginValidation -skipMacroValidation test \
  2>&1 | tee "$evidence/live-gateways.log"
