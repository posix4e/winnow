#!/bin/bash
# Record the UI journey and checkpoints, optionally reusing a shared test build.
set -euo pipefail
UI_RESULTS="${1:?usage: ci-ui-journey <fresh-results-directory> [--skip-build]}"
UI_SKIP_BUILD=false
case "${2:-}" in
  "") ;;
  --skip-build)
    : "${SIMULATOR_ID:?--skip-build requires SIMULATOR_ID}"
    : "${DERIVED_DATA:?--skip-build requires DERIVED_DATA}"
    UI_SKIP_BUILD=true
    ;;
  *) echo "usage: ci-ui-journey <fresh-results-directory> [--skip-build]" >&2; exit 2 ;;
esac
[[ $# -le 2 ]] || { echo "too many arguments" >&2; exit 2; }
UI_SIMULATOR_ID="${SIMULATOR_ID:-$(scripts/ios-simulator iPhone)}"
UI_DERIVED_DATA="${DERIVED_DATA:-$HOME/Library/Caches/winnow-node-app}"
mkdir -p "$UI_RESULTS"
for artifact in ui-build.log fixture-prepare.log node-ui.log NodeUI.xcresult journey.mp4 video.log story-events.jsonl node.log; do
  if [[ -e "$UI_RESULTS/$artifact" ]]; then
    echo "Refusing to overwrite existing UI evidence: $UI_RESULTS/$artifact" >&2
    exit 1
  fi
done

UI_XCODE_ARGS=(
  -project WinnowApp.xcodeproj -scheme WinnowApp -configuration Debug
  -destination "platform=iOS Simulator,id=$UI_SIMULATOR_ID"
  -derivedDataPath "$UI_DERIVED_DATA"
  -only-testing:WinnowAppUITests
  -skipPackagePluginValidation -skipMacroValidation
)
if [[ "$UI_SKIP_BUILD" != true ]]; then
  xcodebuild build-for-testing "${UI_XCODE_ARGS[@]}" \
    2>&1 | tee "$UI_RESULTS/ui-build.log"
fi

# Run the specification emitted by the shared build directly. Going through
# the project again resolves the package graph even for test-without-building,
# wasting recording time and CPU before the UI runner can launch.
shopt -s nullglob
UI_TEST_RUNS=("$UI_DERIVED_DATA"/Build/Products/WinnowApp_*.xctestrun)
shopt -u nullglob
if [[ ${#UI_TEST_RUNS[@]} -ne 1 ]]; then
  echo "Expected exactly one WinnowApp test-run specification in $UI_DERIVED_DATA/Build/Products." >&2
  exit 1
fi
UI_STARTED=$SECONDS
phase() { echo "JOURNEY_PHASE $1 elapsed=$((SECONDS - UI_STARTED))s"; }
phase prepared

# Reuse the native package build from CI (or build it incrementally locally).
# Fresh coinbase maturity is fixture setup, not UI work or recording content.
# CI has already matured the bank; this becomes a quick readiness check there.
if [[ -n "${WINNOW_FIXTURE_EXECUTABLE:-}" ]]; then
  "$WINNOW_FIXTURE_EXECUTABLE" prepare-bank 2>&1 | tee "$UI_RESULTS/fixture-prepare.log"
else
  swift run winnow-fixture prepare-bank 2>&1 | tee "$UI_RESULTS/fixture-prepare.log"
fi

# bootstatus handles both a newly booted simulator and one already running.
xcrun simctl boot "$UI_SIMULATOR_ID" > "$UI_RESULTS/video.log" 2>&1 || true
xcrun simctl bootstatus "$UI_SIMULATOR_ID" -b >> "$UI_RESULTS/video.log" 2>&1
phase simulator-ready

UI_VIDEO_PID=""
stop_video() {
  local recorder_status=0 deadline
  if kill -0 "$UI_VIDEO_PID" 2>/dev/null; then
    # SIGINT tells simctl to drain its frames and finalize the movie.
    kill -INT "$UI_VIDEO_PID" 2>/dev/null || recorder_status=1
    deadline=$((SECONDS + 30))
    while kill -0 "$UI_VIDEO_PID" 2>/dev/null; do
      if (( SECONDS >= deadline )); then
        echo "Video recorder did not finish within 30 seconds." >&2
        kill -KILL "$UI_VIDEO_PID" 2>/dev/null || true
        recorder_status=1
        break
      fi
      sleep 0.2
    done
  else
    echo "Video recorder exited before the journey finished." >&2
    recorder_status=1
  fi
  if wait "$UI_VIDEO_PID"; then
    :
  else
    echo "Video recorder failed; see $UI_RESULTS/video.log." >&2
    recorder_status=1
  fi
  if [[ ! -s "$UI_RESULTS/journey.mp4" ]]; then
    echo "Video recorder produced no movie." >&2
    recorder_status=1
  fi
  return "$recorder_status"
}

collect_diagnostics() {
  local app_container journal
  if app_container=$(xcrun simctl get_app_container "$UI_SIMULATOR_ID" com.btcswift.app data 2>/dev/null); then
    journal="$app_container/Library/Application Support/BTCSwiftE2E-smoke/story-events.jsonl"
    if [[ -f "$journal" ]]; then cp "$journal" "$UI_RESULTS/story-events.jsonl" || true; fi
  fi
  if [[ -n "${WINNOW_DATADIR:-}" && -f "$WINNOW_DATADIR/signet/debug.log" ]]; then
    cp "$WINNOW_DATADIR/signet/debug.log" "$UI_RESULTS/node.log" || true
  fi
}

finish() {
  local result=$?
  trap - EXIT INT TERM
  if [[ -n "$UI_VIDEO_PID" ]]; then
    if ! stop_video && (( result == 0 )); then result=1; fi
  fi
  collect_diagnostics
  phase finalized
  exit "$result"
}
trap finish EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

xcrun simctl io "$UI_SIMULATOR_ID" recordVideo --codec=h264 "$UI_RESULTS/journey.mp4" \
  >> "$UI_RESULTS/video.log" 2>&1 &
UI_VIDEO_PID=$!

# simctl emits this only after processing its first frame. The test must
# not launch the app until the recording is ready to include onboarding.
# A cold hosted simulator can acknowledge its first frame after 30 seconds
# even after bootstatus finishes. Keep readiness bounded without retrying
# the journey or recording only part of it.
UI_VIDEO_READY=false
UI_VIDEO_DEADLINE=$((SECONDS + 60))
while (( SECONDS < UI_VIDEO_DEADLINE )); do
  if ! kill -0 "$UI_VIDEO_PID" 2>/dev/null; then
    echo "Video recorder stopped before its first frame; see $UI_RESULTS/video.log." >&2
    exit 1
  fi
  if grep -qF "Recording started" "$UI_RESULTS/video.log"; then
    UI_VIDEO_READY=true
    break
  fi
  sleep 0.2
done
if [[ "$UI_VIDEO_READY" != true ]]; then
  echo "Video recorder did not start within 60 seconds; see $UI_RESULTS/video.log." >&2
  exit 1
fi
phase recording-ready

xcodebuild test-without-building -xctestrun "${UI_TEST_RUNS[0]}" \
  -destination "platform=iOS Simulator,id=$UI_SIMULATOR_ID" \
  -only-testing:WinnowAppUITests \
  -test-timeouts-enabled YES -maximum-test-execution-time-allowance 600 \
  -collect-test-diagnostics never \
  -resultBundlePath "$UI_RESULTS/NodeUI.xcresult" \
  2>&1 | tee "$UI_RESULTS/node-ui.log"
phase tests-finished
