#!/usr/bin/env python3
"""Tables for the peer-census post, from WinnowCensus JSONL.

    scripts/census-tables census.jsonl [TIP]

TIP defaults to the median reported height of usable peers."""
import collections, json, re, statistics, sys

SPLIT = 961632
rows = [json.loads(l) for l in open(sys.argv[1]) if l.strip()]
ok = [r for r in rows if r["outcome"] == "ok"]
heights = sorted(r["startHeight"] for r in ok if r.get("startHeight"))
tip = int(sys.argv[2]) if len(sys.argv) > 2 else (heights[len(heights) // 2] if heights else 0)

def pct(n, d): return "-" if not d else f"{100*n/d:.1f}%"
def family(ua):
    if "Knots" in ua: return "Knots"
    if ua.startswith("/Satoshi:"): return "Core"
    for k in ("btcd", "bcoin", "libbitcoin", "Bitcoin ABC", "bitcoinj", "Gocoin"):
        if k in ua: return k
    return "other"
def major(ua):
    m = re.search(r"/Satoshi:(\d+\.\d+)", ua)
    return m.group(1) if m else "?"

print(f"dialled {len(rows)}; observed tip {tip}\n")
print("| Outcome | Nodes | Share |")
print("|---|---|---|")
for o in ["ok", "noCompactFilters", "unreachable", "timeout", "handshakeFailed", "protocolViolation"]:
    n = sum(1 for r in rows if r["outcome"] == o)
    if n: print(f"| {o} | {n} | {pct(n, len(rows))} |")

answered = [r for r in rows if r["outcome"] in ("ok", "noCompactFilters")]
print(f"\nanswered a handshake: {len(answered)}; of those advertising compact filters: {pct(len(ok), len(answered))}\n")

print("| Family | Usable peers | At tip | Stuck at split | >100 behind | Median fee filter |")
print("|---|---|---|---|---|---|")
groups = collections.defaultdict(list)
for r in ok: groups[family(r["userAgent"] or "")].append(r)
for name, members in sorted(groups.items(), key=lambda kv: -len(kv[1])):
    at_tip = sum(1 for r in members if tip - r["startHeight"] <= 100)
    stuck = sum(1 for r in members if SPLIT <= r["startHeight"] <= SPLIT + 20)
    behind = sum(1 for r in members if tip - r["startHeight"] > 100)
    ff = sorted(r["feeFilterSatPerKvB"] for r in members if r.get("feeFilterSatPerKvB") is not None)
    med = f"{ff[len(ff)//2]/1000:.1f} sat/vB" if ff else "-"
    print(f"| {name} | {len(members)} | {pct(at_tip, len(members))} | {pct(stuck, len(members))} | {pct(behind, len(members))} | {med} |")

print("\n| Knots build | Usable peers | Stuck at split |")
print("|---|---|---|")
kn = collections.defaultdict(list)
for r in groups.get("Knots", []):
    m = re.search(r"Knots:(\d+)", r["userAgent"] or "")
    kn[m.group(1) if m else "?"].append(r)
for build, members in sorted(kn.items()):
    stuck = sum(1 for r in members if SPLIT <= r["startHeight"] <= SPLIT + 20)
    print(f"| {build} | {len(members)} | {pct(stuck, len(members))} |")

print("\n| Core major | Usable peers | At tip |")
print("|---|---|---|")
co = collections.defaultdict(list)
for r in groups.get("Core", []): co[major(r["userAgent"] or "")].append(r)
for v, members in sorted(co.items(), key=lambda kv: kv[0]):
    at_tip = sum(1 for r in members if tip - r["startHeight"] <= 100)
    print(f"| {v} | {len(members)} | {pct(at_tip, len(members))} |")

ffs = [r["feeFilterSatPerKvB"] for r in ok if r.get("feeFilterSatPerKvB") is not None]
if ffs:
    print(f"\nfee filters seen on {len(ffs)} usable peers: median {statistics.median(ffs)/1000:.2f} sat/vB, "
          f"over 10 sat/vB: {sum(1 for f in ffs if f > 10_000)}, over 100 sat/vB: {sum(1 for f in ffs if f > 100_000)}")
lat = sorted(r["latencyMs"] for r in ok)
if lat:
    print(f"handshake latency: median {lat[len(lat)//2]} ms, p90 {lat[int(len(lat)*0.9)]} ms")
stuck_all = [r for r in ok if SPLIT <= r["startHeight"] <= SPLIT + 20]
ahead = [r for r in ok if r["startHeight"] - tip > 10]
print(f"claiming a chain taller than the tip: {len(ahead)}")
for r in ahead[:6]: print(f"  {r['host'][:30]} {r['startHeight']} {r['userAgent']}")
nets = collections.defaultdict(list)
for r in rows: nets[r.get("network", "clearnet")].append(r)
print("\n| Network | Dialled | Usable | No compact filters | Stuck at split (of usable) |")
print("|---|---|---|---|---|")
for name, members in sorted(nets.items()):
    u = [r for r in members if r["outcome"] == "ok"]
    ncf = sum(1 for r in members if r["outcome"] == "noCompactFilters")
    st = sum(1 for r in u if SPLIT <= r["startHeight"] <= SPLIT + 20)
    print(f"| {name} | {len(members)} | {len(u)} ({pct(len(u), len(members))}) | {pct(ncf, len(members))} | {st} ({pct(st, len(u))}) |")
print(f"\nusable peers a Winnow client could seat that are stuck on the dead chain: {len(stuck_all)} of {len(ok)} ({pct(len(stuck_all), len(ok))})")
