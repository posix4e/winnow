#!/usr/bin/env python3
"""Reuse successful journey media only when every test/build input matches."""
from datetime import datetime, timezone
import hashlib
import json
import os
from pathlib import Path
import posixpath
import re
import shlex
import subprocess
import sys
from urllib.parse import urlencode


BUNDLED_PAGES = {
    "docs/site.css", "docs/mobile.html", "docs/read-side.html",
    "docs/write-side.html", "docs/import.html",
}
SITE_ONLY = {
    ".github/workflows/site.yml",
    "scripts/build-site", "scripts/check-site", "scripts/prepare-site-artifact",
    "scripts/tests/test_build_site.py", "scripts/tests/test_check_site.py",
    "scripts/tests/test_prepare_site_artifact.py",
}


def bundled_paths(project):
    paths = set(BUNDLED_PAGES)
    for line in project.splitlines():
        if "docs" not in line or line.lstrip().startswith("#"):
            continue
        match = re.match(r"\s*-?\s*path:\s*(.*)", line)
        try:
            values = shlex.split(match[1], comments=True) if match else []
        except ValueError:
            values = []
        # Unknown resource syntax conservatively includes all website files.
        if len(values) != 1 or any(char in values[0] for char in "*?[]{}$"):
            paths.add("docs")
        else:
            resource = posixpath.normpath(values[0])
            if resource == "docs" or resource.startswith("docs/"):
                paths.add(resource)
    return paths


def is_test_input(path, bundled):
    if any(path == resource or path.startswith(resource + "/") for resource in bundled):
        return True
    input_tree = path.startswith(("Sources/", "Tools/", "Tests/", "AppTests/", "UITests/", "scripts/tests/"))
    prose = path.lower().endswith(".md") and (posixpath.basename(path).lower() == "readme.md" or not input_tree)
    return not (path.startswith("docs/") or prose or path in SITE_ONLY)


def fingerprint(ref="HEAD", cwd=None):
    # NUL-delimited tree entries preserve paths, modes, and object IDs without
    # reading LFS media or depending on timestamps, checkout order, or commits.
    tree = subprocess.check_output(["git", "ls-tree", "-r", "-z", "--full-tree", ref], cwd=cwd)
    entries = [entry for entry in tree.split(b"\0") if entry]
    project = next((entry for entry in entries if entry.endswith(b"\tproject.yml")), None)
    project_text = subprocess.check_output(
        ["git", "cat-file", "blob", project.split(b"\t", 1)[0].split()[2].decode()],
        cwd=cwd, text=True) if project else ""
    bundled = bundled_paths(project_text)
    entries = [entry for entry in entries
               if is_test_input(entry.split(b"\t", 1)[1].decode("utf-8", "surrogateescape"), bundled)]
    return hashlib.sha256(b"".join(entry + b"\0" for entry in sorted(entries))).hexdigest()


def api(path):
    return json.loads(subprocess.check_output(
        ["gh", "api", "-H", "Accept: application/vnd.github+json", path],
        text=True, stderr=subprocess.PIPE, timeout=30))


def can_reuse(event, ref):
    return event == "pull_request" or (event == "push" and ref == "refs/heads/main")


def trusted_source_event(event, branch):
    return event in {"pull_request", "workflow_dispatch"} or (event in {"push", "schedule"} and branch == "main")


def find_artifact(repository, repository_id, digest, request=api, now=None):
    name = f"journey-media-{digest}"
    query = urlencode({"name": name, "per_page": 100})
    artifacts = request(f"repos/{repository}/actions/artifacts?{query}")["artifacts"]
    now = now or datetime.now(timezone.utc)
    for artifact in artifacts:
        try:
            source = artifact["workflow_run"]
            if (artifact["name"] != name or artifact["expired"] is not False
                    or artifact["size_in_bytes"] <= 0
                    or datetime.fromisoformat(artifact["expires_at"].replace("Z", "+00:00")) <= now
                    or source["repository_id"] != repository_id
                    or source["head_repository_id"] != repository_id):
                continue
            run_id = source["id"]
            if not isinstance(run_id, int) or run_id <= 0:
                continue
            run = request(f"repos/{repository}/actions/runs/{run_id}")
            if (run["id"] != run_id
                    or run["path"].split("@", 1)[0] != ".github/workflows/ci.yml"
                    or run["status"] != "completed" or run["conclusion"] != "success"
                    or run["repository"]["id"] != repository_id
                    or run["head_repository"]["id"] != repository_id
                    or run["head_sha"] != source["head_sha"]
                    or not trusted_source_event(run["event"], run["head_branch"])):
                continue
        except (KeyError, TypeError, ValueError, AttributeError):
            continue
        return {"run-id": str(run_id), "artifact-name": name}
    return None


def main():
    if len(sys.argv) != 1:
        raise SystemExit("usage: ci-journey-cache")
    digest = fingerprint()
    evidence = None
    if can_reuse(os.environ.get("GITHUB_EVENT_NAME"), os.environ.get("GITHUB_REF")):
        try:
            repository_id = int(os.environ["GITHUB_REPOSITORY_ID"])
            if repository_id > 0:
                evidence = find_artifact(os.environ["GITHUB_REPOSITORY"], repository_id, digest)
        except (KeyError, TypeError, ValueError, OSError, subprocess.SubprocessError):
            print("Journey media lookup unavailable; running fresh checks.", file=sys.stderr)
    outputs = {"fingerprint": digest, "reuse": str(evidence is not None).lower()}
    if evidence:
        outputs.update(evidence)
    text = "".join(f"{key}={value}\n" for key, value in outputs.items())
    print(text, end="")
    if output := os.environ.get("GITHUB_OUTPUT"):
        with Path(output).open("a") as destination:
            destination.write(text)
    if summary := os.environ.get("GITHUB_STEP_SUMMARY"):
        if evidence:
            server = os.environ.get("GITHUB_SERVER_URL", "https://github.com").rstrip("/")
            source = f"{server}/{os.environ['GITHUB_REPOSITORY']}/actions/runs/{evidence['run-id']}"
            message = ("Wallet and test inputs are unchanged. Tests and journey media are reused from "
                       f"[successful CI run {evidence['run-id']}]({source}); the retained media keeps its original recording provenance.")
        else:
            message = "Running fresh wallet tests and the recorded journey; the retained media keeps its original recording provenance."
        with Path(summary).open("a") as destination:
            destination.write(f"### Journey evidence\n\n{message}\n")


if __name__ == "__main__":
    main()
