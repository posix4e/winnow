#!/usr/bin/env bash
# No test may be a silent no-op. Every environment gate a test reads must be
# set by some workflow or script that CI runs. Conditional suites need an
# explicit platform exception, and retired gates must not hide never-run
# suites. Runs in CI's combined build job.
set -euo pipefail
cd "$(dirname "$0")/.."

TEST_DIRS=(Tests UITests AppTests)
for d in Tools/*/Tests; do [ -d "$d" ] && TEST_DIRS+=("$d"); done
SETTERS=(.github/workflows scripts)
# Optional overrides a developer may set by hand; never a gate.
ALLOW_UNSET="WINNOW_BITCOIN_CLI"
# Conditional skips that are deliberate and documented. The live gateway
# journey needs a device or simulator on the tailnet; scripts/check-live-gateways-ui runs it.
ALLOW_XCTSKIP="AppTests/E2EModeTests.swift UITests/LiveGatewayDeviceTests.swift"
# Retired gates: node integration now runs through the one UI journey.
DENY='WINNOW_DIFF|WINNOW_SIGNET|WINNOW_HEADERS_BIN|WINNOW_GENERATE_FALLBACK_PEERS'

status=0

# 1. Every WINNOW_* name a test reads is set somewhere CI runs.
names=$(grep -rhoE 'environment\["WINNOW_[A-Z0-9_]+"\]|environmentValue\("WINNOW_[A-Z0-9_]+"\)' "${TEST_DIRS[@]}" \
  | grep -oE 'WINNOW_[A-Z0-9_]+' | sort -u)
for name in $names; do
  case " $ALLOW_UNSET " in *" $name "*) continue ;; esac
  # Substring match: xcodebuild forwards TEST_RUNNER_-prefixed names.
  if ! grep -rqF "$name" "${SETTERS[@]}"; then
    echo "::error::$name is read by a test but set by no workflow or script"
    status=1
  fi
done

# 2. File-protection attributes are measured
# where the OS records them; the same suite is included in iOS AppTests.
# The live gateway check needs the tailnet that runs them; scripts/check-live-gateways sets its gate.
# The tailnet simulation needs Headscale and tailscaled running; scripts/ci-tailnet sets its gate.
if grep -rn 'enabled(if:' "${TEST_DIRS[@]}" | sed -E 's/^([^:]+):[0-9]+:/\1:/' \
  | grep -vF 'Tests/WalletCoreTests/FileProtectionTests.swift:@Suite("Persisted file protection", .enabled(if: fileProtectionRecorded))' \
  | grep -vF 'Tests/WalletCoreTests/Network/TailnetGatewayDiscoveryTests.swift:    @Test(.enabled(if: ProcessInfo.processInfo.environment["WINNOW_LIVE_GATEWAYS"] == "1"))' \
  | grep -vF 'Tests/WalletCoreTests/Network/TailnetGatewayDiscoveryTests.swift:    @Test(.enabled(if: ProcessInfo.processInfo.environment["WINNOW_TAILNET_SIMULATION"] == "1"))'; then
  echo "::error::an undocumented conditional test suite was found"
  status=1
fi

# 3. XCTSkip only where documented.
while IFS= read -r file; do
  case " $ALLOW_XCTSKIP " in *" $file "*) ;; *)
    echo "::error::$file uses XCTSkip; add it to ALLOW_XCTSKIP with a reason, or remove the skip"
    status=1 ;;
  esac
done < <(grep -rlE 'XCTSkip' "${TEST_DIRS[@]}" || true)

# 4. The retired gates stay retired (code patterns, not prose).
if grep -rnE "environment\[\"($DENY)\"\]|environmentValue\(\"($DENY)\"\)" "${TEST_DIRS[@]}" scripts .github; then
  echo "::error::a retired test gate is back"
  status=1
fi

if [ "$status" -eq 0 ]; then echo "test gates: every gate is set, every skip is documented"; fi
exit "$status"
