#!/bin/bash
# Live check of the tailnet peer gateways (docs/peer-gateways.md), by hand from
# a Mac on the tailnet that runs them; CI has no tailnet, so it never runs this.
# Fetches the census list a build would ship (scripts/import-census), discovers
# both named gateways and completes a Bitcoin handshake through each with peers
# from that list. Sends no wallet addresses or transactions.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
if [ $# -gt 0 ]; then
  echo 'usage: scripts/check-live-gateways' >&2
  exit 64
fi
scripts/import-census
export WINNOW_LIVE_GATEWAYS=1 WINNOW_LIVE_CENSUS=build/census/peers.json
exec swift test --filter LiveOverlayTests.deployedMagicDNSGateways
