*.xcarchive
*.ipa

# Signing material. An embedded.mobileprovision already ships inside every
# .xcarchive; these rules catch one exported anywhere else.
*.mobileprovision
*.p12
*.cer
*.certSigningRequest

# Local Python checks
__pycache__/
