import Winnow.Wallet.CharactersData

/-! # Swift `Character`s (extended grapheme clusters)

`String.count`, `prefix(_:)` and `lowercased()` in the wallet's bounded-text rules (`DisplayName`,
`ImportBundle.excerpt`, `PersonPaste.addressError`) and the app's label rules work on Swift `Character`s.
This is the UAX #29 extended grapheme cluster segmenter, every rule GB1–GB999 (GB9b Prepend, GB9c Indic
conjuncts, GB11 emoji ZWJ sequences, GB12/13 regional-indicator pairs), over the properties of Swift's
own stdlib.

The tables (`CharactersData`, generated by `LeanOracle/Characters/tables.py`) are measured, not
copied from the Unicode data files: `Probe.swift` splices every scalar `c` (0…0x10FFFF, no surrogates)
into fixed strings and asks Swift for `String.count`, and each property is read off (the Hangul classes,
Extended_Pictographic and InCB Consonant / Extend from both a left and a right context, the two required
to agree):
* CR, LF: `c LF` / `CR c` is one `Character`. Control: `c U+0301` is two (only GB4 breaks before an Extend).
* Extend ∪ SpacingMark ∪ ZWJ: `a c` is one. ZWJ: `😀 c 😀` is one. Extend: `😀 c ZWJ 😀` is one
  (GB11 allows Extend, not SpacingMark, between the pictograph and the ZWJ); SpacingMark is the rest.
* Prepend: `c a` is one. Regional indicators: `c 🇺` is one and `c c c` is two.
* Hangul: L, V, T, LV, LVT from `c L0` / `c V0` / `c T0` and `L0 c` / `V0 c` / `T0 c` (U+1100, U+1161,
  U+11A8). LV ∪ LVT is exactly U+AC00–U+D7A3 with LV the syllables whose index is a multiple of 28, so
  the table stores the syllable block and `gcb` computes which.
* Extended_Pictographic: `c ZWJ 😀` and `😀 ZWJ c` are one.
* Indic_Conjunct_Break: Consonant from `c ् क` and `क ् c` (U+0915, U+094D); Linker from `क c क`;
  Extend from `क ् c क` and `क c ् क`.
The probe also checks that nothing joins U+0001 on either side, that the classes are disjoint and that
InCB consonants are Grapheme_Cluster_Break Other. Measured from Swift 6.4 on macOS 27 (Unicode 17.0):
Swift agrees with UAX #29 as written; the sets match its derivations (Control includes the unassigned
default-ignorables, Extended_Pictographic the reserved emoji blocks, SpacingMark U+0E33 / U+0EB3 (Lo),
InCB=Extend has ZWJ but not ZWNJ). The whole segmenter was fuzzed against Swift's
`Array(s).map(String.init)`: every string of one to three scalars from a set of class representatives,
and 1.05 million random strings biased towards these rules, with no disagreement. -/

namespace Winnow.Characters

/-- The packed property of a scalar (see `runs`): the last run starting at or before it. -/
def prop (c : Nat) : Nat := Id.run do
  let rs := runs
  let mut lo := 0
  let mut hi := rs.size
  -- rs[lo] starts at or before c (rs[0] starts at 0); rs[hi] (if any) after it.
  while lo + 1 < hi do
    let mid := (lo + hi) / 2
    if (rs[mid]!.toNat >>> 8) ≤ c then lo := mid else hi := mid
  return rs[lo]!.toNat &&& 0xFF

/-- Grapheme_Cluster_Break classes. -/
inductive Gcb where
  | other | cr | lf | control | extend | zwj | regional | prepend | spacingMark | l | v | t | lv | lvt
  deriving BEq, Inhabited

/-- Indic_Conjunct_Break. -/
inductive InCB where
  | none | consonant | linker | extend
  deriving BEq, Inhabited

def gcb (c : Nat) (p : Nat) : Gcb :=
  match p &&& 0xF with
  | 1 => .cr | 2 => .lf | 3 => .control | 4 => .extend | 5 => .zwj | 6 => .regional | 7 => .prepend
  | 8 => .spacingMark | 9 => .l | 10 => .v | 11 => .t
  | 12 => if (c - 0xAC00) % 28 == 0 then .lv else .lvt
  | _ => .other

def isPictographic (p : Nat) : Bool := p &&& 0x10 != 0

def incb (p : Nat) : InCB :=
  match (p >>> 5) &&& 3 with
  | 1 => .consonant | 2 => .linker | 3 => .extend | _ => .none

/-- What the rules need to know about the scalars before the current one. -/
structure State where
  /-- The class of the previous scalar. -/
  prev : Gcb
  /-- Regional indicators ending at the previous scalar (GB12/13). -/
  regionals : Nat
  /-- GB11: 0 nothing, 1 after `ExtPict Extend*`, 2 after `ExtPict Extend* ZWJ`. -/
  emoji : Nat
  /-- GB9c: 0 nothing, 1 after `Consonant [Extend Linker]*` with no Linker yet, 2 with a Linker. -/
  conjunct : Nat

/-- Whether a boundary separates the previous scalar (described by `s`) from one with class `g`,
properties `p`. -/
def boundary (s : State) (g : Gcb) (p : Nat) : Bool :=
  if s.prev == .cr && g == .lf then false                                                    -- GB3
  else if s.prev == .cr || s.prev == .lf || s.prev == .control then true                      -- GB4
  else if g == .cr || g == .lf || g == .control then true                                     -- GB5
  else if s.prev == .l && (g == .l || g == .v || g == .lv || g == .lvt) then false            -- GB6
  else if (s.prev == .lv || s.prev == .v) && (g == .v || g == .t) then false                  -- GB7
  else if (s.prev == .lvt || s.prev == .t) && g == .t then false                              -- GB8
  else if g == .extend || g == .zwj then false                                                -- GB9
  else if g == .spacingMark then false                                                        -- GB9a
  else if s.prev == .prepend then false                                                       -- GB9b
  else if s.conjunct == 2 && incb p == .consonant then false                                  -- GB9c
  else if s.emoji == 2 && isPictographic p then false                                         -- GB11
  else if s.prev == .regional && g == .regional && s.regionals % 2 == 1 then false            -- GB12/13
  else true                                                                                   -- GB999

/-- The state after a scalar with class `g`, properties `p`. -/
def State.step (s : State) (g : Gcb) (p : Nat) : State :=
  { prev := g
    regionals := if g == .regional then s.regionals + 1 else 0
    emoji :=
      if isPictographic p then 1
      else if s.emoji == 1 && g == .extend then 1
      else if s.emoji == 1 && g == .zwj then 2
      else 0
    conjunct :=
      match incb p with
      | .consonant => 1
      | .linker => if s.conjunct ≥ 1 then 2 else 0
      | .extend => s.conjunct
      | .none => 0 }

/-- The string's `Character`s. -/
def characters (s : String) : Array String := Id.run do
  let mut out : Array String := #[]
  let mut cur : String := ""
  let mut st : Option State := none
  for ch in s.toList do
    let c := ch.toNat
    let p := prop c
    let g := gcb c p
    match st with
    | some st' =>
      if boundary st' g p then
        out := out.push cur
        cur := String.singleton ch
      else cur := cur.push ch
      st := some (st'.step g p)
    | none =>
      cur := String.singleton ch
      st := some ({ prev := .other, regionals := 0, emoji := 0, conjunct := 0 : State }.step g p)
  if st.isSome then out := out.push cur
  return out

def count (s : String) : Nat := (characters s).size

def «prefix» (s : String) (n : Nat) : String := String.join ((characters s).toList.take n)

end Winnow.Characters
