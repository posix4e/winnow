/-- `NetworkParams.generatedMainnetFallbackPeers` as (host, port); `Params` wraps them in `PeerEndpoint`. -/
def generatedMainnetFallbackPeerList : Array (String × UInt16) :=
  ((fallbackPeerText.splitOn " ").filter (· ≠ "")).toArray.map fun s =>
    match s.splitOn "@" with
    | [h, p] => (h, p.toNat!.toUInt16)
    | _ => (s, 0)

